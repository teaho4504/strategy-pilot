# Frontend/browser environment only.
# Leave empty for local Vite proxy: /api -> http://localhost:8000
VITE_API_BASE_URL=

# Same Wi-Fi mobile testing example. Replace with your Mac/server LAN IP.
# VITE_API_BASE_URL=http://192.168.0.10:8000

# Cloud/mobile deployment example.
# VITE_API_BASE_URL=https://api.your-domain.com

# Do not put Kiwoom App Key, Secret Key, Access Token, or account number here.
