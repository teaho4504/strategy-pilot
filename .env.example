# Browser/mobile frontend only. Do not put Kiwoom secrets here.
# Empty value keeps local Vite proxy behavior: /api -> http://localhost:8000
VITE_API_BASE_URL=

# Examples:
# Local mobile device on the same Wi-Fi, replace with your Mac/server LAN IP:
# VITE_API_BASE_URL=http://192.168.0.10:8000
# Cloud/mobile deployment:
# VITE_API_BASE_URL=https://api.your-domain.com
