# Default is mock. Live Kiwoom calls are blocked unless KIWOOM_MODE=live.
KIWOOM_MODE=mock

# Server
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://15.165.117.114

# Kiwoom REST API credentials. Keep these in backend/.env only.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_ACCOUNT_NO=

# Explicit live API endpoints. Override only when Kiwoom changes official hosts.
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_TOKEN_URL=https://api.kiwoom.com/oauth2/token
KIWOOM_REAL_API_BASE_URL=https://api.kiwoom.com
KIWOOM_MOCK_API_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_DEV_API_BASE_URL=https://apidev.kiwoom.com

# Safety defaults. Orders must remain disabled until a separate risk-controlled phase.
KIWOOM_READ_ONLY=true
KIWOOM_ENABLE_ORDER=false

# Safe defaults for read-only account queries.
KIWOOM_STEX_TP=0
KIWOOM_QRY_TP=3
KIWOOM_DMST_STEX_TP=KRX
KIWOOM_WATCHLIST=005930,000660,035420
