# Backend runs in mock mode unless this is explicitly changed to live.
KIWOOM_MODE=mock

# Required only when KIWOOM_MODE=live.
KIWOOM_API_BASE_URL=https://api.kiwoom.com
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCESS_TOKEN=
KIWOOM_ACCOUNT_NO=

# Local development CORS origins.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
